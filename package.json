{
  "name": "sicr-e-learning",
  "version": "1.0.0",
  "description": "SICR E-Learning & Knowledge Management System - Soft Inter Chiangrai",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/sync-version.js && ng serve",
    "prebuild": "node scripts/sync-version.js",
    "build": "ng build sic-ng",
    "postbuild": "node scripts/copy-theme-assets.js",
    "build:demo": "ng build demo --configuration production",
    "build:vercel": "npm run build && npm run build:demo",
    "release": "node scripts/release-sic-ng.mjs",
    "prepare": "npm run build",
    "watch": "node scripts/sync-version.js && ng build --watch --configuration development",
    "pretest": "node scripts/sync-version.js",
    "test": "ng test"
  },
  "packageManager": "npm@11.16.0",
  "module": "./dist/sic-ng/fesm2022/sic-ng.mjs",
  "types": "./dist/sic-ng/types/sic-ng.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/sic-ng/types/sic-ng.d.ts",
      "default": "./dist/sic-ng/fesm2022/sic-ng.mjs"
    },
    "./theme/*": "./dist/sic-ng/theme/*"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cdk": "^22.0.3",
    "@angular/cli": "^22.0.5",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
